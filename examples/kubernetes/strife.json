{
  "name": "etcd-k8s",
  "seed": 42,
  "duration": "60s",
  "nodes": [
    { "name": "n1", "ip": "auto", "pod": "etcd-0", "container": "etcd" },
    { "name": "n2", "ip": "auto", "pod": "etcd-1", "container": "etcd" },
    { "name": "n3", "ip": "auto", "pod": "etcd-2", "container": "etcd" }
  ],
  "transport": { "type": "kubernetes", "namespace": "strife" },
  "db": {
    "kind": "etcd",
    "endpoints": ["http://{ip}:2379"],
    "process": "etcd --name",
    "start": "/usr/local/bin/start-etcd.sh"
  },
  "workload": {
    "keys": 4,
    "values": 5,
    "concurrency": 10,
    "read_ratio": 0.5,
    "cas_ratio": 0.2,
    "timeout": "2s"
  },
  "nemesis": {
    "faults": ["partition", "kill", "pause", "latency", "loss"],
    "interval": "8s",
    "length": "6s",
    "interface": "eth0"
  }
}
