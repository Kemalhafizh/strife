{
  "name": "mysql-repeatable-read",
  "seed": 7,
  "duration": "60s",
  "nodes": [
    { "name": "n1", "ip": "172.31.4.11", "container": "strife-mysql1", "cgroup": "auto" }
  ],
  "transport": {
    "type": "docker",
    "sudo": true
  },
  "db": {
    "kind": "mysql",
    "endpoints": ["172.31.4.11:3306"],
    "user": "root",
    "password": "env:STRIFE_MYSQL_PASSWORD",
    "database": "strife"
  },
  "workload": {
    "model": "append",
    "isolation": "snapshot-isolation",
    "keys": 6,
    "txn_len": 4,
    "concurrency": 10,
    "read_ratio": 0.5,
    "think": "5ms",
    "timeout": "5s"
  },
  "nemesis": {
    "faults": [],
    "interval": "10s",
    "length": "3s"
  }
}
