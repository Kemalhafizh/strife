{
  "name": "etcd-3-cgroup",
  "seed": 42,
  "duration": "120s",
  "nodes": [
    { "name": "n1", "ip": "172.30.0.11", "container": "strife-etcd1", "cgroup": "auto" },
    { "name": "n2", "ip": "172.30.0.12", "container": "strife-etcd2", "cgroup": "auto" },
    { "name": "n3", "ip": "172.30.0.13", "container": "strife-etcd3", "cgroup": "auto" }
  ],
  "transport": {
    "type": "docker",
    "sudo": true
  },
  "db": {
    "kind": "etcd",
    "endpoints": ["http://172.30.0.11:2379", "http://172.30.0.12:2379", "http://172.30.0.13:2379"],
    "process": "etcd --name",
    "start": "/usr/local/bin/start-etcd.sh"
  },
  "workload": {
    "keys": 4,
    "values": 5,
    "concurrency": 10,
    "read_ratio": 0.5,
    "cas_ratio": 0.2,
    "timeout": "2s"
  },
  "nemesis": {
    "faults": ["freeze", "io-stall"],
    "interval": "10s",
    "length": "4s",
    "io_device": "auto"
  }
}
