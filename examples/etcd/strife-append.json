{
  "name": "etcd-3-append",
  "seed": 42,
  "duration": "120s",
  "nodes": [
    { "name": "n1", "ip": "172.30.0.11", "container": "strife-etcd1" },
    { "name": "n2", "ip": "172.30.0.12", "container": "strife-etcd2" },
    { "name": "n3", "ip": "172.30.0.13", "container": "strife-etcd3" }
  ],
  "transport": {
    "type": "docker"
  },
  "db": {
    "kind": "etcd",
    "endpoints": ["http://172.30.0.11:2379", "http://172.30.0.12:2379", "http://172.30.0.13:2379"],
    "process": "etcd --name",
    "start": "/usr/local/bin/start-etcd.sh"
  },
  "workload": {
    "model": "append",
    "isolation": "strict-serializable",
    "keys": 4,
    "txn_len": 4,
    "writes_per_key": 32,
    "concurrency": 10,
    "read_ratio": 0.5,
    "timeout": "2s"
  },
  "nemesis": {
    "faults": ["partition", "kill", "pause", "latency", "loss"],
    "interval": "10s",
    "length": "8s",
    "interface": "eth0"
  }
}
