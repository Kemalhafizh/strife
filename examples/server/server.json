{
  "listen": ":8080",
  "data": "/var/lib/strife",
  "public_url": "https://strife.internal.example",
  "projects": [
    {
      "name": "payments",
      "token": "env:STRIFE_PAYMENTS_TOKEN",
      "read_token": "env:STRIFE_PAYMENTS_READ_TOKEN",
      "trusted_keys": ["keys/ci-release.pub"],
      "require_signature": true,
      "webhook": "env:STRIFE_PAYMENTS_WEBHOOK",
      "retain": 2000
    },
    {
      "name": "ledger",
      "token": "file:/run/secrets/strife-ledger-token"
    },
    {
      "name": "accounts",
      "read_token": "env:STRIFE_ACCOUNTS_READ_TOKEN",
      "oidc": [
        {
          "issuer": "https://token.actions.githubusercontent.com",
          "audience": "strife",
          "claims": { "repository_id": "123456789", "ref": "refs/heads/main" }
        }
      ]
    }
  ]
}
