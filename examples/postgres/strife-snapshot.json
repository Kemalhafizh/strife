{
  "name": "postgres-snapshot-isolation",
  "seed": 42,
  "duration": "60s",
  "nodes": [
    {
      "name": "n1",
      "ip": "172.31.1.11",
      "container": "strife-postgres1"
    }
  ],
  "transport": {
    "type": "docker"
  },
  "db": {
    "kind": "postgres",
    "endpoints": [
      "172.31.1.11:5432"
    ],
    "user": "postgres",
    "password": "env:STRIFE_PG_PASSWORD",
    "tls": "require",
    "process": "postgres",
    "start": "/usr/local/bin/start-postgres.sh"
  },
  "workload": {
    "model": "append",
    "isolation": "snapshot-isolation",
    "keys": 6,
    "txn_len": 4,
    "concurrency": 10,
    "read_ratio": 0.5,
    "think": "5ms",
    "timeout": "5s"
  },
  "nemesis": {
    "faults": [
      "kill",
      "pause"
    ],
    "interval": "10s",
    "length": "4s",
    "interface": "eth0"
  }
}
