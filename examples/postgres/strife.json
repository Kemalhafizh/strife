{
  "name": "postgres-cluster",
  "seed": 42,
  "duration": "60s",
  "nodes": [
    { "name": "n1", "ip": "172.31.1.11", "container": "strife-postgres1" },
    { "name": "n2", "ip": "172.31.1.12", "container": "strife-postgres2" },
    { "name": "n3", "ip": "172.31.1.13", "container": "strife-postgres3" }
  ],
  "transport": { "type": "docker" },
  "db": {
    "kind": "postgres",
    "endpoints": ["172.31.1.11:5432", "172.31.1.12:5432", "172.31.1.13:5432"],
    "process": "postgres",
    "start": "/usr/local/bin/start-postgres.sh"
  },
  "workload": {
    "model": "kv",
    "keys": 4,
    "values": 5,
    "concurrency": 8,
    "read_ratio": 0.5,
    "cas_ratio": 0.2,
    "timeout": "2s"
  },
  "nemesis": {
    "faults": ["partition", "pause"],
    "interval": "8s",
    "length": "6s",
    "interface": "eth0"
  }
}
